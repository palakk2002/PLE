  <script>
    (function () {
      try {
        const storage = localStorage.getItem('theme-storage');
        if (storage) {
          const parsed = JSON.parse(storage);
          if (parsed && parsed.state && parsed.state.theme === 'dark') {
            document.documentElement.classList.add('dark');
          }
        }
      } catch (e) { }
    })();
  </script>
</head>

<body>
